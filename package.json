{
  "name": "ascend",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev": "shopify app dev",
    "build": "npm run build -w @ascend/shared && npm run build -w ascend-app",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run build -w @ascend/shared && npm run typecheck -ws --if-present",
    "setup": "npm run setup -w ascend-app",
    "seed": "npm run seed -w ascend-app"
  },
  "devDependencies": {
    "@shopify/cli": "^3.77.0"
  },
  "engines": {
    "node": ">=20"
  }
}
